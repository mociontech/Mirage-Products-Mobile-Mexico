# Copiar a .env.local y llenar por pais/despliegue. Nunca commitear .env.local.
# En Netlify: configurar estas mismas variables en Site settings > Environment variables.

# Pais de este despliegue, ISO 3166-1 alpha-2 (CO / MX). Nunca hardcodear,
# nunca compartir el mismo valor entre despliegues.
VITE_COUNTRY=MX

# Identifica el dispositivo fisico que envio un registro (opcional, util si
# hay mas de un celular activo en el mismo evento).
VITE_KIOSK_ID=

# Nombre de esta experiencia tal como debe aparecer como "source" en Evius -
# mismo valor que usa el sync-server de la version tablet+pitch, para que
# ambas cuenten como la misma fuente en Evius.
VITE_EXPERIENCE_NAME="Mirage - Catalogo de Productos"

# Evius Datahub — mismo evento/experiencia que ya usa la version tablet+pitch
# (VITE_EVIUS_EXPERIENCE_ID es el experienceId de "Catalogo", no el de
# Memory Match).
VITE_EVIUS_URL=
VITE_EVIUS_TOKEN=
VITE_EVIUS_EVENT_ID=
VITE_EVIUS_EXPERIENCE_ID=

# Supabase compartido con Memory Match ("Mirage Colombia" - el nombre es solo
# una etiqueta, ahi escriben ambos paises y ambas experiencias). Tabla:
# participations, unico en (participant_id, country, experience).
# VITE_RANKING_DB_URL = Project URL pelada, sin /rest/v1 ni nombre de tabla.
# VITE_RANKING_DB_API_KEY = la Publishable key del proyecto (sb_publishable_...),
# NUNCA la Secret key — a diferencia del sync-server de la version tablet+
# pitch (que usa la service_role key desde un servidor propio), esta app es
# estatica y corre en el navegador del visitante: cualquier key que se le
# entregue queda expuesta en el bundle. La tabla `participations` tiene RLS
# con policy de INSERT (no UPDATE/SELECT) para el rol anon.
VITE_RANKING_DB_URL=
VITE_RANKING_DB_API_KEY=
VITE_RANKING_DB_TABLE=participations
