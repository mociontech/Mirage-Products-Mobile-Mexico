# Copiar a .env.local y llenar por pais/despliegue. Nunca commitear .env.local.
# En Netlify: configurar estas mismas variables en Site settings > Environment variables.

# Pais de este despliegue, ISO 3166-1 alpha-2 (CO / MX). Nunca hardcodear,
# nunca compartir el mismo valor entre despliegues.
VITE_COUNTRY=MX

# Identifica el dispositivo fisico que envio un registro (opcional, util si
# hay mas de un celular activo en el mismo evento).
VITE_KIOSK_ID=

# Nombre de esta experiencia tal como debe aparecer como "source" en Evius.
VITE_EXPERIENCE_NAME="Mirage - Productos"

# Evius Datahub — evento propio de este despliegue/pais.
VITE_EVIUS_URL=
VITE_EVIUS_TOKEN=
VITE_EVIUS_EVENT_ID=
